{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SCTG Handoff",
  "type": "object",
  "required": [
    "from_seat",
    "to_seat",
    "artifact",
    "artifact_hash",
    "acceptance"
  ],
  "properties": {
    "from_seat": {
      "type": "string"
    },
    "to_seat": {
      "type": "string"
    },
    "artifact": {
      "type": "string"
    },
    "artifact_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]+$"
    },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "scope": {
      "type": "object"
    },
    "on_reject": {
      "type": "string"
    }
  }
}
