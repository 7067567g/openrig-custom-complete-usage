{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SCTG DecisionRecord",
  "type": "object",
  "required": [
    "decision_id",
    "request_id",
    "approved_by",
    "decision",
    "chosen_option",
    "scope",
    "conditions",
    "expiry",
    "bound_object_hash"
  ],
  "properties": {
    "decision_id": {
      "type": "string"
    },
    "request_id": {
      "type": "string"
    },
    "approved_by": {
      "const": "MAIN"
    },
    "decision": {
      "enum": [
        "approved",
        "rejected"
      ]
    },
    "chosen_option": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "scope": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "conditions": {
      "type": "string"
    },
    "expiry": {
      "type": "string"
    },
    "bound_object_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]+$"
    },
    "mode_change": {
      "type": "object"
    },
    "at": {
      "type": "string"
    }
  }
}
